#!/usr/bin/with-contenv bashio
# ============================================================================
# ttyd — the web terminal
#
# Attaches every browser connection to a persistent tmux session named 'claude'.
# Sessions survive tab close, iframe reload, and add-on restart (except a
# hard container recreate, which is rare).
# ============================================================================
set -e

PORT="${TTYD_PORT:-7681}"
SURVIVE=$(bashio::config 'survive_restart' 'true')
AUTO_LAUNCH=$(bashio::config 'auto_launch_claude' 'true')
DANGEROUS=$(bashio::config 'dangerously_skip_permissions' 'false')
WORKDIR=$(bashio::config 'working_directory' '/config')

# Fallback if user gave a path that doesn't exist inside the container.
# HOME is guaranteed to exist by cont-init 10-env.sh.
if [ ! -d "$WORKDIR" ]; then
    bashio::log.warning "[ttyd] working_directory '$WORKDIR' does not exist — falling back to \$HOME ($HOME)"
    WORKDIR="$HOME"
fi

bashio::log.info "[ttyd] starting on port ${PORT}"
bashio::log.info "[ttyd]   survive_restart=${SURVIVE}"
bashio::log.info "[ttyd]   auto_launch_claude=${AUTO_LAUNCH}"
bashio::log.info "[ttyd]   working_directory=${WORKDIR}"

# Export env for the shells ttyd spawns (mirrors /etc/profile.d/che-env.sh
# so services.d and cont-init.d see the same paths).
export HOME="/data/home"
export XDG_CONFIG_HOME="/data/.config"
export XDG_CACHE_HOME="/data/.cache"
export XDG_STATE_HOME="/data/.local/state"
export XDG_DATA_HOME="/data/.local/share"
export ANTHROPIC_CONFIG_DIR="/data/.config/claude"
export ANTHROPIC_HOME="/data"
export DISABLE_AUTOUPDATER=1
export IS_SANDBOX=1
export GH_CONFIG_DIR="/data/.config/gh"
export PATH="/data/packages/bin:/data/packages/python/venv/bin:/data/home/.local/bin:/data/npm/bin:$PATH"

# Build the Claude launch command
CLAUDE_FLAGS=""
if [ "$DANGEROUS" = "true" ]; then
    CLAUDE_FLAGS="--dangerously-skip-permissions"
    bashio::log.warning "[ttyd] Claude launching with --dangerously-skip-permissions"
fi

if [ "$AUTO_LAUNCH" = "true" ]; then
    LAUNCH_CMD="cd \"$WORKDIR\" && clear && echo 'Welcome to CHE Claude in HomE Assistant' && echo '' && sleep 1 && claude ${CLAUDE_FLAGS}; /usr/local/bin/claude-session-picker"
else
    LAUNCH_CMD="cd \"$WORKDIR\" && clear && /usr/local/bin/claude-session-picker"
fi

export CLAUDE_LAUNCH_CMD="$LAUNCH_CMD"
export CLAUDE_WORKDIR="$WORKDIR"

# Decide what ttyd hands each browser connection
if [ "$SURVIVE" = "true" ]; then
    # Persistent tmux: pre-create the 'claude' session so first connect is instant.
    # -c pins tmux's starting cwd so shells inside inherit it — critical because
    # Claude Code keys its per-project memory by cwd (see cont-init 20-claude-source).
    if ! tmux has-session -t claude 2>/dev/null; then
        bashio::log.info "[ttyd] creating persistent tmux session 'claude' in $WORKDIR"
        tmux new-session -d -s claude -c "$WORKDIR" bash -c 'eval "$CLAUDE_LAUNCH_CMD"'
    else
        bashio::log.info "[ttyd] reusing existing tmux session 'claude'"
    fi
    SHELL_CMD="/usr/local/bin/claude-tmux"
else
    # Fresh shell every connect (survive_restart=false). SIGHUP-on-close is
    # inherited from ttyd — every tab-switch/refresh kills the process. Without
    # tmux holding the session this becomes noticeable pain. Documented in DOCS.md.
    SHELL_CMD="bash -c 'cd \"$WORKDIR\" && eval \"$CLAUDE_LAUNCH_CMD\"'"
fi

# Build the custom shell — ttyd's own page with our top bar injected into it.
# ttyd serves exactly one self-contained page and mounts it into document.body,
# so there is no route to iframe and --index REPLACES the terminal rather than
# wrapping it. build-ttyd-shell patches ttyd's own HTML instead.
#
# If anything about that fails, fall through to ttyd's stock UI. A broken shell
# must never cost someone their terminal.
SHELL_HTML="/opt/ttyd-shell/index.html"
INDEX_ARG=""
ADDON_INFO="$(curl -s -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
    http://supervisor/addons/self/info 2>/dev/null || true)"
ADDON_VER="$(printf '%s' "$ADDON_INFO" | jq -r '.data.version // empty' 2>/dev/null || true)"
ADDON_SLUG="$(printf '%s' "$ADDON_INFO" | jq -r '.data.slug // empty' 2>/dev/null || true)"
# HA 2026.x renamed add-ons to "apps" and moved the panel from
# /hassio/addon/<slug>/info to /config/app/<slug>/info. Pick by core version so
# this stays correct on older installs too.
HA_VER="$(curl -s -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
    http://supervisor/core/info 2>/dev/null | jq -r '.data.version // empty' 2>/dev/null || true)"
HA_MAJOR="${HA_VER%%.*}"
if [ -n "$HA_MAJOR" ] && [ "$HA_MAJOR" -ge 2026 ] 2>/dev/null; then
    ADDON_PAGE_PATH="/config/app"
else
    ADDON_PAGE_PATH="/hassio/addon"
fi

mkdir -p /opt/ttyd-shell
if build-ttyd-shell "$SHELL_HTML" "$ADDON_VER" "$ADDON_SLUG" "$ADDON_PAGE_PATH" >/dev/null 2>&1; then
    INDEX_ARG="--index ${SHELL_HTML}"
    bashio::log.info "[ttyd] custom shell built (v${ADDON_VER:-unknown})"
else
    bashio::log.warning "[ttyd] shell build failed — serving stock ttyd UI"
fi

# ttyd flags:
#   --index                   — our patched page (top bar + terminal), if built
#   --writable                — allow keyboard input (not read-only viewer)
#   --interface 0.0.0.0       — bind all interfaces (ingress needs this)
#   --ping-interval 30        — keep websocket alive through proxies
#   --client-option reconnect=5           — auto-reconnect after 5s
#   --client-option scrollback=100000     — 100k line browser scrollback (THE fix)
#   --client-option disableLeaveAlert=true — no "leave page?" prompt on tab close
exec ttyd \
    --port "${PORT}" \
    --interface 0.0.0.0 \
    ${INDEX_ARG} \
    --writable \
    --ping-interval 30 \
    --client-option reconnect=5 \
    --client-option scrollback=100000 \
    --client-option disableLeaveAlert=true \
    --client-option 'theme={"background":"#1e1e2e"}' \
    ${SHELL_CMD}
